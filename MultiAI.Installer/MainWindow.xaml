<ui:FluentWindow
    x:Class="MultiAI.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Multi.AI Setup"
    Width="680"
    Height="520"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Multi.AI Setup" Icon="/Assets/AppIcon.ico"/>

        <!-- Top Step Indicator -->
        <Border Grid.Row="1" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="24,12" Background="#0AFFFFFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Step1Text" Text="1. Welcome" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Step2Text" Grid.Column="1" Text="2. License" Foreground="#6E6E6E" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Step3Text" Grid.Column="2" Text="3. Options" Foreground="#6E6E6E" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Step4Text" Grid.Column="3" Text="4. Install" Foreground="#6E6E6E" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main View Container -->
        <ContentControl x:Name="MainContainer" Grid.Row="2"/>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="3" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="24,16" Background="#0AFFFFFF">
            <Grid>
                <ui:Button x:Name="CancelButton" Content="Cancel" Appearance="Secondary" HorizontalAlignment="Left" Width="90" Click="CancelButton_Click"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BackButton" Content="Back" Appearance="Secondary" Width="90" Click="BackButton_Click" IsEnabled="False" Margin="0,0,12,0"/>
                    <ui:Button x:Name="NextButton" Content="Next" Appearance="Primary" Width="100" Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
