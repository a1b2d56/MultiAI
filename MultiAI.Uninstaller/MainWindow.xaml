<ui:FluentWindow
    x:Class="MultiAI.Uninstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Multi.AI Uninstaller"
    Width="520"
    Height="340"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowBackdropType="Mica">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="Assets/AppIcon.ico" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Uninstall Multi.AI" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Remove Multi.AI and all its components from this PC" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Content Card -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16" Padding="20">
            <StackPanel>
                <TextBlock x:Name="PromptText" Text="Are you sure you want to uninstall Multi.AI? This will remove all local application files and desktop shortcuts." TextWrapping="Wrap" LineHeight="20"/>
                
                <ProgressBar x:Name="UninstallProgressBar" IsIndeterminate="true" Visibility="Collapsed" Height="6" Margin="0,14,0,0"/>
                <TextBlock x:Name="StatusText" Text="" Foreground="#B0B0B0" FontSize="12" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
        </ui:CardControl>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton" Content="Cancel" Appearance="Secondary" Width="90" Click="CancelButton_Click" Margin="0,0,12,0"/>
                <ui:Button x:Name="UninstallButton" Content="Uninstall" Appearance="Danger" Width="100" Click="UninstallButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
