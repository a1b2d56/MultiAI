<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MultiAI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MultiAI.Converters"
    xmlns:local="using:MultiAI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:RoleToUserVisibilityConverter x:Key="RoleToUserVisibilityConverter"/>
            <converters:RoleToAiVisibilityConverter x:Key="RoleToAiVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
