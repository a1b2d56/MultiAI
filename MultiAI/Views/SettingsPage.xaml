<Page
    x:Class="MultiAI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MultiAI.Views"
    xmlns:vm="using:MultiAI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage API connections and customize interface preferences." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,8"/>

            <InfoBar IsOpen="{x:Bind ViewModel.IsSaveSuccessOpen, Mode=TwoWay}" 
                     Severity="Success" 
                     Title="Status Update" 
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Margin="0,0,0,4" />

            <!-- Appearance Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE771;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox x:Name="ThemeComboBox" Header="Application Theme" Width="240" 
                               SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=OneWay}" 
                               SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="System Default"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Google Gemini Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="#4285F4"/>
                            <TextBlock Text="Google Gemini Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasGeminiKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="GeminiApiKeyBox" Header="API Key" PlaceholderText="AIzaSy..." Password="{x:Bind ViewModel.GeminiApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateGemini_Click"/>
                        <Button Content="Save Key" Click="SaveGemini_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OpenAI Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#10A37F"/>
                            <TextBlock Text="OpenAI Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasOpenAIKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    
                    <PasswordBox x:Name="OpenAIApiKeyBox" Header="API Key" PlaceholderText="sk-..." Password="{x:Bind ViewModel.OpenAIApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateOpenAI_Click"/>
                        <Button Content="Save Key" Click="SaveOpenAI_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Anthropic Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7BE;" FontSize="20" Foreground="#D97706"/>
                            <TextBlock Text="Anthropic Claude Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasAnthropicKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="AnthropicApiKeyBox" Header="API Key" PlaceholderText="sk-ant-..." Password="{x:Bind ViewModel.AnthropicApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateAnthropic_Click"/>
                        <Button Content="Save Key" Click="SaveAnthropic_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Groq Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#F55036"/>
                            <TextBlock Text="Groq High-Speed Inference" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasGroqKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="GroqApiKeyBox" Header="API Key" PlaceholderText="gsk_..." Password="{x:Bind ViewModel.GroqApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateGroq_Click"/>
                        <Button Content="Save Key" Click="SaveGroq_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DeepSeek Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#4D6BFE"/>
                            <TextBlock Text="DeepSeek Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasDeepSeekKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="DeepSeekApiKeyBox" Header="API Key" PlaceholderText="sk-..." Password="{x:Bind ViewModel.DeepSeekApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateDeepSeek_Click"/>
                        <Button Content="Save Key" Click="SaveDeepSeek_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mistral AI Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#FF7000"/>
                            <TextBlock Text="Mistral AI Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasMistralKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="MistralApiKeyBox" Header="API Key" PlaceholderText="API Key..." Password="{x:Bind ViewModel.MistralApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateMistral_Click"/>
                        <Button Content="Save Key" Click="SaveMistral_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OpenRouter Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="#6366F1"/>
                            <TextBlock Text="OpenRouter Unified API" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasOpenRouterKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="OpenRouterApiKeyBox" Header="API Key" PlaceholderText="sk-or-v1-..." Password="{x:Bind ViewModel.OpenRouterApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateOpenRouter_Click"/>
                        <Button Content="Save Key" Click="SaveOpenRouter_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- xAI (Grok) Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="xAI (Grok) Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasXAIKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="XAIApiKeyBox" Header="API Key" PlaceholderText="xai-..." Password="{x:Bind ViewModel.XAIApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateXAI_Click"/>
                        <Button Content="Save Key" Click="SaveXAI_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Ollama (Local AI) Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEC27;" FontSize="20" Foreground="#047857"/>
                            <TextBlock Text="Ollama Local AI (Offline)" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasOllamaKey, Mode=OneWay}">
                            <TextBlock Text="Ready" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBox x:Name="OllamaHostBox" Header="Host URL (Default: http://localhost:11434)" Text="{x:Bind ViewModel.OllamaHost, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Connection" Click="ValidateOllama_Click"/>
                        <Button Content="Save Endpoint" Click="SaveOllama_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
