<Page
    x:Class="MultiAI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MultiAI.Views"
    xmlns:vm="using:MultiAI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20" MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage API connections and customize interface preferences." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,8"/>

            <InfoBar IsOpen="{x:Bind ViewModel.IsSaveSuccessOpen, Mode=TwoWay}" 
                     Severity="Success" 
                     Title="Status Update" 
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Margin="0,0,0,4" />

            <!-- Appearance Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE771;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <ComboBox x:Name="ThemeComboBox" Header="Application Theme" Width="240" 
                              SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=OneWay}" 
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="System Default"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- OpenAI Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#10A37F"/>
                            <TextBlock Text="OpenAI Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasOpenAIKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    
                    <PasswordBox x:Name="OpenAIApiKeyBox" Header="API Key" PlaceholderText="sk-..." Password="{x:Bind ViewModel.OpenAIApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateOpenAI_Click"/>
                        <Button Content="Save Key" Click="SaveOpenAI_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Anthropic Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7BE;" FontSize="20" Foreground="#D97706"/>
                            <TextBlock Text="Anthropic Claude Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasAnthropicKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="AnthropicApiKeyBox" Header="API Key" PlaceholderText="sk-ant-..." Password="{x:Bind ViewModel.AnthropicApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateAnthropic_Click"/>
                        <Button Content="Save Key" Click="SaveAnthropic_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Google Gemini Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="#4285F4"/>
                            <TextBlock Text="Google Gemini Configuration" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.HasGeminiKey, Mode=OneWay}">
                            <TextBlock Text="Configured" FontSize="12" Foreground="Green" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <PasswordBox x:Name="GeminiApiKeyBox" Header="API Key" PlaceholderText="AIzaSy..." Password="{x:Bind ViewModel.GeminiApiKey, Mode=OneWay}" Width="480" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Validate Key" Click="ValidateGemini_Click"/>
                        <Button Content="Save Key" Click="SaveGemini_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
