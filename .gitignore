## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]RM/
[Aa]RM64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# SQLite databases
*.db
*.db3
*.sqlite
*.sqlite3

# Windows credential/secrets
secrets.json

# Packages & Installer Outputs
packages/
*.nupkg
*.msix
*.msixbundle
*.msixupload
*.appxupload
payload.zip
temp_staging/
temp_uninstaller/
MultiAI.Installer/Resources/payload.zip

